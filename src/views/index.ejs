<%- include('partials/header') %>

<section>
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h2 mb-1">Minhas viagens</h1>
      <p class="text-muted mb-0">Gerencie seus registros de viagem em um só lugar.</p>
    </div>
    <a class="btn btn-primary" href="/trip/new">Adicionar viagem</a>
  </div>

  <% if (!trips || trips.length === 0) { %>
    <div class="alert alert-info">Nenhuma viagem cadastrada ainda. Adicione sua primeira viagem!</div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-md-2 g-4">
      <% trips.forEach((trip) => { %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title mb-2">
                <span class="fw-semibold"><%= trip.destination %></span>
                <small class="text-muted">— <%= trip.country %></small>
              </h5>
              <p class="card-text mb-2">
                <strong>Período:</strong>
                <%= new Date(trip.startDate).toLocaleDateString('pt-BR') %>
                até
                <%= new Date(trip.endDate).toLocaleDateString('pt-BR') %>
              </p>
              <% if (trip.notes) { %>
                <p class="card-text flex-grow-1"><%= trip.notes %></p>
              <% } else { %>
                <p class="card-text text-muted flex-grow-1">Sem anotações adicionais.</p>
              <% } %>
              <div class="mt-3 d-flex gap-2">
                <a class="btn btn-outline-primary btn-sm" href="/trip/<%= trip.id %>">Detalhes</a>
                <button
                  class="btn btn-outline-danger btn-sm delete-trip-btn"
                  data-trip-id="<%= trip.id %>"
                >
                  Excluir
                </button>
              </div>
            </div>
            <div class="card-footer text-muted small">
              Registrado em <%= new Date(trip.createdAt).toLocaleDateString('pt-BR') %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
