<%- include('partials/header') %>

<section class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm overflow-hidden">
      <div class="add-trip-banner text-white p-4">
        <span class="badge bg-success bg-opacity-75 text-uppercase mb-3">Planejar trilhas</span>
        <h1 class="h4 mb-2">Adicionar nova viagem</h1>
        <p class="mb-0 text-white-50">
          Registre destinos, datas e notas especiais para construir um diario vibrante das suas jornadas.
        </p>
      </div>
      <div class="card-body p-4 p-md-5">
        <% if (errors && errors.length) { %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% errors.forEach((error) => { %>
                <li><%= error %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form id="trip-form" action="/trip" method="POST" novalidate>
          <div class="mb-3">
            <label for="destination" class="form-label">Destino</label>
            <input
              type="text"
              class="form-control"
              id="destination"
              name="destination"
              value="<%= formData?.destination || '' %>"
              required
            />
            <div class="invalid-feedback">Informe o destino da viagem.</div>
          </div>

          <div class="mb-3">
            <label for="country" class="form-label">Pais</label>
            <input
              type="text"
              class="form-control"
              id="country"
              name="country"
              value="<%= formData?.country || '' %>"
              required
            />
            <div class="invalid-feedback">Informe o pais da viagem.</div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label for="start_date" class="form-label">Data de inicio</label>
              <input
                type="date"
                class="form-control"
                id="start_date"
                name="start_date"
                value="<%= formData?.startDate ? formData.startDate.slice(0, 10) : '' %>"
                required
              />
              <div class="invalid-feedback">Informe a data de inicio.</div>
            </div>
            <div class="col-md-6">
              <label for="end_date" class="form-label">Data de termino</label>
              <input
                type="date"
                class="form-control"
                id="end_date"
                name="end_date"
                value="<%= formData?.endDate ? formData.endDate.slice(0, 10) : '' %>"
                required
              />
              <div class="invalid-feedback">Informe a data de termino.</div>
            </div>
          </div>

          <div class="mb-3 mt-3">
            <label for="notes" class="form-label">Anotacoes</label>
            <textarea
              class="form-control"
              id="notes"
              name="notes"
              rows="4"
              placeholder="Insira observacoes importantes, dicas ou memorias marcantes."
            ><%= formData?.notes || '' %></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-bookmark-plus me-2"></i>Salvar viagem
            </button>
            <a href="/" class="btn btn-outline-secondary">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
